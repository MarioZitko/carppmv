# Copy to .env and fill in values before running the app.

# PostgreSQL connection string (async driver required).
# Port 5433 matches docker-compose.yml's default host port (kept off 5432
# to avoid clashing with a locally installed Postgres).
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5433/carppmv

# Credentials docker-compose.yml uses to initialize the container; must match
# the DATABASE_URL above.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=carppmv
POSTGRES_PORT=5433

# OpenRouter credentials — required only for catalogue ingestion (llm_mapper.py),
# not for normal API operation.
OPENROUTER_API_KEY=

# LLM model used for column mapping during catalogue ingestion.
# Default matches the code default; override to use a different model.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Set to true to enable debug-level logging.
DEBUG=false

# Comma-separated list of origins allowed to call the API from a browser.
# The Next.js frontend (frontend/) runs on :3000 in dev.
CORS_ALLOW_ORIGINS=http://localhost:3000

# mobile.de on-demand scraping via Apify actor (see docs/MOBILE_DE_APIFY_SPEC.md).
APIFY_API_TOKEN=
APIFY_MOBILE_DE_ACTOR_ID=ivanvs/mobile-de-scraper
APIFY_CALL_TIMEOUT_SECONDS=60
LISTING_CACHE_TTL_HOURS=24
DAILY_APIFY_BUDGET_CALLS=200

# Cloudflare Turnstile (bot protection on /calculate) and IP hashing salt.
TURNSTILE_SECRET_KEY=your_secret_here
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_site_key_here
IP_HASH_SALT=your_generated_salt_here

